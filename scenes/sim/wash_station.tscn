[sub_resource type="Shader" id="Shader_tiles"]
code = "shader_type spatial;
// 노란 타일 벽 (임시 그래픽): 10 cm 타일과 흰 줄눈
uniform vec4 tile_color : source_color = vec4(0.98, 0.84, 0.5, 1.0);
uniform vec4 grout_color : source_color = vec4(0.95, 0.93, 0.88, 1.0);
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 cell = fract(vec2(world_pos.x, world_pos.y) / 0.15);
	float grout = step(cell.x, 0.04) + step(cell.y, 0.04);
	ALBEDO = mix(tile_color.rgb, grout_color.rgb, clamp(grout, 0.0, 1.0));
	ROUGHNESS = 0.4;
}
"

