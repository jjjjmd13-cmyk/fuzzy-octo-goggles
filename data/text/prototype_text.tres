[gd_resource type="Resource" script_class="" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/text/prototype_text.gd" id="1_text"]

[resource]
script = ExtResource("1_text")
intro_title = "등불 원정대 — 시제품"
intro_body = "목표: 가장 안쪽 방 끝의 푸르게 빛나는 출구까지 가세요.
E 로 등불을 줍고, 마우스 휠로 밝기를 바꿉니다 (밝을수록 기름이 빨리 닳습니다).
기름은 모두가 같이 씁니다. 바닥의 빛 원 안이 안전한 곳입니다.
빛 밖 어둠에 오래 있으면 그림자가 쫓아옵니다. 등불로 비추면 도망갑니다."
intro_seconds = 12.0
need_lantern_hint = "등불을 들어야 밝기를 바꿀 수 있습니다 (E 로 줍기)"
level_notice = "등불 %s — 빛 %d m"
stalked_warning = "무언가 어둠 속에서 다가온다…"
attack_warning = "뒤에 있다! 빛 안으로!"
success_message = "원정 성공!
%d초 뒤 다시 시작"
fail_message = "전원 쓰러짐 — 원정 실패
%d초 뒤 다시 시작"
