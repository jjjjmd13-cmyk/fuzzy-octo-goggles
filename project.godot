config_version=5

[application]

config/name="Lanternfall"
config/description="등불 원정대 (가제) — 시제품"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

SteamService="*res://scripts/net/steam_service.gd"
Net="*res://scripts/net/network_manager.gd"
Tuning="*res://scripts/core/tuning.gd"
UiTheme="*res://scripts/core/ui_theme.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

